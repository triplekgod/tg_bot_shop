# Токен бота из @BotFather
BOT_TOKEN=123456789:PASTE_YOUR_TOKEN_HERE

# Telegram ID администраторов через запятую.
# Узнать свой ID можно у @userinfobot или командой /id в уже запущенном боте.
ADMIN_IDS=123456789

# Главный администратор: может добавлять и удалять других админов.
SUPER_ADMIN_ID=123456789

# Файл базы данных SQLite
DB_PATH=support_bot.sqlite3

# -------------------------
# 3x-ui API для продления подписок
# -------------------------
# Адрес панели. Если у панели есть секретный URI Path, добавьте его в конец.
# Пример: https://example.com:2053/randompath
XUI_BASE_URL=https://example.com:2053

# Вариант 1: API-токен из Settings -> Security -> API Token
XUI_API_TOKEN=

# Вариант 2: логин и пароль от панели, если API-токен не используется
XUI_USERNAME=admin
XUI_PASSWORD=your_panel_password

# Если у панели самоподписанный SSL-сертификат, можно временно поставить false
XUI_VERIFY_SSL=true
XUI_TIMEOUT=20

# Сколько клиентов показывать на одной странице команды /clients
XUI_CLIENTS_PER_PAGE=10

# Для 3x-ui Node: показывать клиента один раз, даже если он прикреплён к нескольким inbounds.
XUI_GROUP_CLIENTS_BY_EMAIL=true

# Важно: чтобы заявки продлевались одной кнопкой, у клиента в панели 3x-ui
# должно быть заполнено поле tgId его Telegram ID.
# Если админ вручную вводит email в заявке, бот может сам записать tgId в панель.
XUI_SYNC_TGID_TO_PANEL_ON_LINK=true

# Режим продления. Для 3x-ui Node нужен clients_api.
XUI_RENEW_MODE=clients_api

# Способ продления в Clients API:
# bulk_adjust — основной режим: /panel/api/clients/bulkAdjust, добавляет дни к подписке.
# update — запасной режим: /panel/api/clients/update/{email}, выставляет expiryTime.
XUI_CLIENTS_RENEW_METHOD=bulk_adjust

# true — если подписка уже истекла, новый срок считается от текущего момента.
# false — всегда просто добавлять дни к старому expiryTime через bulkAdjust.
XUI_RENEW_EXPIRED_FROM_NOW=true

# Используется только если XUI_RENEW_MODE=legacy_inbound. Для clients_api не нужен.
XUI_MAIN_INBOUND_ID=

# На сколько дней продлевать, если в команде не указать DAYS
XUI_DEFAULT_RENEW_DAYS=30

# Настройки кнопки «Продлить подписку» у клиента
# 1 месяц в заявке клиента переводится в 30 дней для подсказки админу
XUI_DAYS_PER_MONTH=30
XUI_MAX_RENEW_MONTHS=24

# Обычно Clients API применяет изменения сам. Включайте true только если нужно перезапускать Xray после продления.
XUI_RESTART_XRAY_AFTER_RENEW=false

# -------------------------
# Telegram Stars как способ оплаты
# -------------------------
# true — в заявке на продление у админа будет кнопка «⭐️ Счёт Telegram Stars».
# Для Stars не нужен provider token: бот использует currency=XTR и пустой provider_token.
STARS_PAYMENTS_ENABLED=true
STARS_MIN_AMOUNT=1
STARS_MAX_AMOUNT=100000
# Цена 1 месяца продления в Telegram Stars. Клиентский счёт = месяцы * STARS_PRICE_PER_MONTH.
STARS_PRICE_PER_MONTH=250
STARS_INVOICE_TITLE=Продление подписки
STARS_INVOICE_DESCRIPTION=Оплата продления подписки через Telegram Stars

# -------------------------
# Внутренний баланс и рефералы
# -------------------------
# Внутренний баланс ведётся в рублях. Цена одного месяца при оплате балансом.
BALANCE_PRICE_PER_MONTH=250
# Минимальная и максимальная сумма одного P2P/криптопополнения в рублях.
BALANCE_MIN_TOPUP_RUB=1
BALANCE_MAX_TOPUP_RUB=100000
# Показывать ли клиентам кнопку криптопополнения. По умолчанию выключена,
# но вся логика заявок остаётся в боте для будущего включения.
CRYPTO_TOPUP_ENABLED=false
# Награда пригласившему с каждого подтверждённого пополнения реферала.
REFERRAL_PERCENT=25

# -------------------------
# Оформление новой подписки / добавление клиента
# -------------------------
# Inbound IDs, к которым нужно прикреплять новых клиентов через /panel/api/clients/add.
# Рекомендуется заполнить явно. Узнать ID можно командой /inbounds.
# Пример: XUI_NEW_CLIENT_INBOUND_IDS=1,2,3
XUI_NEW_CLIENT_INBOUND_IDS=

# Лимит трафика нового клиента в байтах. 0 = без лимита.
XUI_NEW_CLIENT_TOTAL_GB=0

# Лимит IP нового клиента. 0 = без лимита.
XUI_NEW_CLIENT_LIMIT_IP=0

# Префикс email, если клиент оформляет подписку сам. Итоговый email будет client_<telegram_id>.
XUI_NEW_CLIENT_EMAIL_PREFIX=client

# Flow для новых клиентов, если нужен, например xtls-rprx-vision. Пусто = не отправлять.
XUI_NEW_CLIENT_FLOW=

# Группа и комментарий клиента, если поддерживается вашей версией 3x-ui.
XUI_NEW_CLIENT_GROUP=
XUI_NEW_CLIENT_COMMENT=Создано ботом техподдержки

# Ссылка подписки, которую бот отправит клиенту после создания.
# Если пусто, берётся XUI_BASE_URL. Обычно шаблон такой: {base}/sub/{subId}
XUI_PUBLIC_SUBSCRIPTION_BASE_URL=
XUI_SUBSCRIPTION_LINK_TEMPLATE={base}/sub/{subId}
